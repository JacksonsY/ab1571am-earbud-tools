!/docs/SOURCES.md
!/docs/TOOLS.md
!/docs/SOFTWARE.md
!/docs/index.html
!/docs/site.css
!/docs/site.js
!/docs/.nojekyll
!/tools/
/tools/*
!/tools/inspect-earbud.swift
!/tools/inspect_nvdm.py
!/tools/wrap_thumb.py
!/tools/check_menu_artwork.swift
!/tools/hold_audio_link.swift
!/scripts/
/scripts/*
!/scripts/build-macos.sh
!/scripts/check.sh
!/prompts/
/prompts/*
